#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case "$link" in
    /*) script=$link ;;
    *) script="$(dirname -- "$script")/$link" ;;
  esac
done
workspace=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)
amazon_node=${AMAZON_NODE:-$workspace/.runtime/node}
if [ ! -x "$amazon_node" ]; then
  printf '%s\n' 'Run amazon/scripts/setup-linux.sh first, or set AMAZON_NODE to a compatible Node executable.' >&2
  exit 1
fi
exec "$amazon_node" "$workspace/src/cli.mjs" "$@"
