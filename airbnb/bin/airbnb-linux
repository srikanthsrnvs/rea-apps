#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case "$link" in
    /*) script=$link ;;
    *) script="$(dirname -- "$script")/$link" ;;
  esac
done
workspace=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)
airbnb_node=${AIRBNB_NODE:-$workspace/.runtime/node}
if [ ! -x "$airbnb_node" ]; then
  printf '%s\n' 'Run airbnb/scripts/setup-linux.sh first, or set AIRBNB_NODE to a compatible Node executable.' >&2
  exit 1
fi
exec "$airbnb_node" "$workspace/bin/airbnb" "$@"
