#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case "$link" in
    /*) script=$link ;;
    *) script="$(dirname -- "$script")/$link" ;;
  esac
done
workspace=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)
resy_node=${RESY_NODE:-$workspace/.runtime/node}
if [ ! -x "$resy_node" ]; then
  printf '%s\n' 'Run resy/scripts/setup-linux.sh first, or set RESY_NODE to a compatible Node executable.' >&2
  exit 1
fi
export RESY_CLOUDFLARED=${RESY_CLOUDFLARED:-$workspace/.runtime/cloudflared}
exec "$resy_node" "$workspace/bin/resy" "$@"
