#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case "$link" in
    /*) script=$link ;;
    *) script="$(dirname -- "$script")/$link" ;;
  esac
done
workspace=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)
expedia_node=${EXPEDIA_NODE:-$workspace/.runtime/node}
if [ ! -x "$expedia_node" ]; then
  printf '%s\n' 'Run expedia/scripts/setup-linux.sh first, or set EXPEDIA_NODE to a compatible Node executable.' >&2
  exit 1
fi
exec "$expedia_node" "$workspace/src/cli.mjs" "$@"
