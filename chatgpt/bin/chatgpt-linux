#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case "$link" in
    /*) script=$link ;;
    *) script="$(dirname -- "$script")/$link" ;;
  esac
done
workspace=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)
chatgpt_node=${CHATGPT_NODE:-$workspace/.runtime/node}
if [ ! -x "$chatgpt_node" ]; then
  printf '%s\n' 'Run chatgpt/scripts/setup-linux.sh first, or set CHATGPT_NODE to a compatible Node executable.' >&2
  exit 1
fi
exec "$chatgpt_node" "$workspace/bin/chatgpt" "$@"
