#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case "$link" in
    /*) script=$link ;;
    *) script="$(dirname -- "$script")/$link" ;;
  esac
done
workspace=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)
opentable_node=${OPENTABLE_NODE:-$workspace/.runtime/node}
if [ ! -x "$opentable_node" ]; then
  printf '%s\n' 'Run opentable/scripts/setup-linux.sh first, or set OPENTABLE_NODE to a compatible Node executable.' >&2
  exit 1
fi
exec "$opentable_node" "$workspace/bin/opentable" "$@"
