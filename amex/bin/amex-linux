#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case "$link" in
    /*) script=$link ;;
    *) script="$(dirname -- "$script")/$link" ;;
  esac
done
workspace=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)
amex_node=${AMEX_NODE:-$workspace/.runtime/node}
if [ ! -x "$amex_node" ]; then
  printf '%s\n' 'Run amex/scripts/setup-linux.sh first, or set AMEX_NODE to a compatible Node executable.' >&2
  exit 1
fi
exec "$amex_node" "$workspace/bin/amex" "$@"
